{
	"info": {
		"_postman_id": "student-management-crud-api-v1",
		"name": "Student Management System API",
		"description": "Postman collection for the Student Management System REST API. Private requests send the DRF token through the collection-level Authorization header (\"Token {{token}}\"). Run \"0. Setup Status\" and \"0b. Login and Store Token\" first: the login request stores the returned token in the {{token}} variable, and \"9. Read All Departments\" stores the first department id in {{departmentId}} for the student payloads.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "key",
				"value": "Authorization",
				"type": "string"
			},
			{
				"key": "value",
				"value": "Token {{token}}",
				"type": "string"
			},
			{
				"key": "in",
				"value": "header",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "departmentId",
			"value": "3"
		}
	],
